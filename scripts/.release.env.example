# Copy to scripts/.release.env (gitignored) and fill in.
# Values come from App Store Connect → Users and Access → Integrations → Keys.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Optional — defaults to ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8
# ASC_KEY_PATH=/absolute/path/AuthKey_XXXXXXXXXX.p8
